# Normalize line endings so scripts stay executable across platforms.
# Shell scripts must keep LF: a CRLF shebang fails with "bad interpreter: ...^M".

* text=auto eol=lf

*.sh      text eol=lf
gradlew   text eol=lf

*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.png     binary
*.jpg     binary
*.jar     binary
*.keystore binary
