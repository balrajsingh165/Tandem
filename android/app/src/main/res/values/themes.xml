<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 theme bootstrap for Compose interop and the splash/incoming-call
  window styles.
-->
<resources>
    <style name="Theme.Tandem" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The in-call window shows over the lock screen, so it drops the system
         background and keeps its own surface. -->
    <style name="Theme.Tandem.InCall" parent="Theme.Tandem">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
